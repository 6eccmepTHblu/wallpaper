<Window x:Class="Wallpaper.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Wallpaper — настройки"
        Height="660" Width="920" MinHeight="520" MinWidth="760"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True"
        Background="{DynamicResource Bg}">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Menu.xaml"/>
      </ResourceDictionary.MergedDictionaries>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="Caption" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Ink}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="7,5"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="Padding" Value="12,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}"/>
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Штатный шаблон ComboBox рисует белую плашку мимо Background: тёмный текст на ней не виден. -->
    <Style x:Key="ComboItem" TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}"/>
                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="ItemContainerStyle" Value="{StaticResource ComboItem}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="bd" CornerRadius="5" BorderThickness="1"
                            Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}">
                      <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"
                            Data="M0,0 L4,4.5 L8,0" Stroke="{DynamicResource Muted}" StrokeThickness="1.5"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>

              <ContentPresenter Margin="11,0,30,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                TextElement.Foreground="{DynamicResource Ink}"
                                Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>

              <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                     IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False" PopupAnimation="Fade">
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}"
                        BorderThickness="1" CornerRadius="6" Margin="0,3,0,0"
                        MinWidth="{TemplateBinding ActualWidth}">
                  <ScrollViewer MaxHeight="280">
                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Padding" Value="9,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="b" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Surface2}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}"/>
                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Margin" Value="0,0,16,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="ListBox">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="b" Padding="16,9" Margin="0,0,4,0" CornerRadius="6,6,0,0"
                    Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent">
              <ContentPresenter ContentSource="Header"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{DynamicResource Surface2}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="TabControl">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="14"/>
    </Style>

    </ResourceDictionary>
  </Window.Resources>

  <TabControl Margin="16,12,16,16">

    <!-- ===================== МОНИТОРЫ ===================== -->
    <TabItem Header="Мониторы">
      <Grid Margin="0,14,0,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}" Padding="10">
          <StackPanel>
            <TextBlock Style="{StaticResource Caption}" Text="РАСПОЛОЖЕНИЕ — НАЖМИ НА МОНИТОР"/>
            <Canvas x:Name="MonCanvas" Height="170" Background="Transparent"/>
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" VerticalAlignment="Top">
          <StackPanel x:Name="MonPanel">
            <TextBlock x:Name="MonTitle" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Имя" Grid.Column="0"/>
              <TextBox x:Name="MonLabel" Grid.Column="1" MaxWidth="320" HorizontalAlignment="Left" Width="320"/>
            </Grid>

            <Grid Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Режим" Grid.Column="0"/>
              <StackPanel Grid.Column="1" Orientation="Horizontal">
                <RadioButton x:Name="ModeOff" Content="Выключено" GroupName="mode"/>
                <RadioButton x:Name="ModeStatic" Content="Картинка" GroupName="mode"/>
                <RadioButton x:Name="ModePlaylist" Content="Плейлист" GroupName="mode"/>
                <RadioButton x:Name="ModeVideo" Content="Видео или веб" GroupName="mode"
                             ToolTip="Проигрывает ролик, анимацию или веб-страницу прямо на рабочем столе, под иконками. Для видео нужна libmpv, веб работает на встроенном в Windows WebView2."/>
              </StackPanel>
            </Grid>

            <Grid x:Name="RowPlaylist" Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Какой плейлист" Grid.Column="0"/>
              <ComboBox x:Name="MonPlaylist" Grid.Column="1" Width="320" HorizontalAlignment="Left"/>
            </Grid>

            <Grid x:Name="RowVideo" Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Файл или адрес" Grid.Column="0"/>
              <TextBox x:Name="MonVideo" Grid.Column="1"
                       ToolTip="Что показывать: mp4, mkv, webm, mov, gif, apng — или локальный .html, или адрес https://… Адрес вписывается сюда руками, файловым диалогом его не выбрать."/>
              <Button x:Name="MonVideoBrowse" Grid.Column="2" Content="Обзор…" Margin="8,0,0,0"
                      ToolTip="Выбрать файл на диске: видео, анимацию или страницу .html"/>
              <CheckBox x:Name="MonVideoSound" Grid.Column="3" Content="Со звуком" Margin="16,0,0,0"
                        ToolTip="Включить звук ролика. По умолчанию выключен: обои со звуком обычно мешают. Переключается на лету по Ctrl+Alt+M."/>
            </Grid>

            <TextBlock x:Name="VideoNote" Style="{StaticResource Hint}" Margin="120,0,0,12"
                       Foreground="{DynamicResource Danger}" Visibility="Collapsed"/>

            <Grid x:Name="RowStatic" Margin="0,0,0,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Файл" Grid.Column="0"/>
              <TextBox x:Name="MonPath" Grid.Column="1" IsReadOnly="True"/>
              <Button x:Name="MonBrowse" Grid.Column="2" Content="Обзор…" Margin="8,0,0,0"/>
            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
          <StackPanel>
            <TextBlock Style="{StaticResource Caption}" Text="ОБЩЕЕ ДЛЯ ВСЕХ МОНИТОРОВ"/>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="Вписывание" Width="120"/>
              <ComboBox x:Name="FitBox" Width="220"/>
              <TextBlock Text="Цвет полей" Width="100" Margin="24,0,0,0"/>
              <TextBox x:Name="BgColor" Width="110" ToolTip="#RRGGBB, пусто — не трогать"/>
              <Border x:Name="BgSwatch" Width="26" Height="26" Margin="8,0,0,0" CornerRadius="4"
                      BorderThickness="1" BorderBrush="{DynamicResource Line}"/>
            </StackPanel>
            <TextBlock Style="{StaticResource Hint}" Margin="0,8,0,0"
                       Text="Windows не умеет разное вписывание на разных мониторах — SetPosition задаётся на всю систему сразу."/>
          </StackPanel>
        </Border>
      </Grid>
    </TabItem>

    <!-- ===================== ПЛЕЙЛИСТЫ ===================== -->
    <TabItem Header="Плейлисты">
      <Grid Margin="0,14,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="220"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,12,0">
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="PlAdd" Content="+ Плейлист" />
            <Button x:Name="PlDel" Content="Удалить" Margin="8,0,0,0"/>
          </StackPanel>
          <ListBox x:Name="PlList"/>
        </DockPanel>

        <DockPanel Grid.Column="1" x:Name="PlPane">
          <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PlName" Grid.Column="0" FontSize="15" Padding="8,6"/>
            <TextBlock x:Name="PlCount" Grid.Column="1" Style="{StaticResource Hint}" Margin="12,0,0,0"/>
          </Grid>

          <Border DockPanel.Dock="Bottom" Style="{StaticResource Card}" Margin="0,10,0,0">
            <StackPanel>
              <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Менять каждые" VerticalAlignment="Center"/>
                <TextBox x:Name="PlInterval" Width="70" Margin="8,0,6,0"/>
                <TextBlock Text="секунд" VerticalAlignment="Center"/>
                <TextBlock Text="Порядок" Margin="24,0,8,0" VerticalAlignment="Center"/>
                <ComboBox x:Name="PlOrder" Width="150"/>
                <TextBlock Text="Фильтр" Margin="24,0,8,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Muted}"/>
                <TextBox x:Name="PlFilter" Width="130" ToolTip="Показывать только файлы с этой подстрокой в имени"/>
              </StackPanel>

              <TextBlock Style="{StaticResource Caption}" Text="ОТКУДА БЕРУТСЯ КАРТИНКИ"/>
              <ListBox x:Name="PlSources" MaxHeight="120" BorderThickness="1"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
              <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="SrcAddFolder" Content="+ Папка…"/>
                <Button x:Name="SrcAddFiles" Content="+ Файлы…" Margin="8,0,0,0"/>
                <Button x:Name="SrcDel" Content="Убрать" Margin="8,0,0,0"/>
                <TextBlock Style="{StaticResource Hint}" Margin="16,0,0,0"
                           Text="Папки и файлы можно просто перетащить в сетку выше"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Padding="2" AllowDrop="True" x:Name="TilesHost">
            <ScrollViewer x:Name="TilesScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" Background="Transparent">
              <WrapPanel x:Name="Tiles" Margin="6"/>
            </ScrollViewer>
          </Border>
        </DockPanel>
      </Grid>
    </TabItem>

    <!-- ===================== ОБЩЕЕ ===================== -->
    <TabItem Header="Общее">
      <ScrollViewer Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <CheckBox x:Name="EnabledBox" Content="Обои включены" Margin="0,0,0,10"
                        ToolTip="Выключенные обои возвращают то, что стояло в Windows до запуска приложения. Переключается и по Ctrl+Alt+0."/>
              <CheckBox x:Name="Autostart" Content="Запускать вместе с Windows"/>
              <TextBlock Style="{StaticResource Hint}" Margin="24,6,0,0"
                         Text="Запись в HKCU\Software\Microsoft\Windows\CurrentVersion\Run"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Style="{StaticResource Caption}" Text="ГОРЯЧИЕ КЛАВИШИ"/>
              <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                         Text="Нажми на поле и набери комбинацию. Действие применяется к монитору под курсором. Backspace очищает."/>
              <StackPanel x:Name="HotkeyRows"/>
              <TextBlock x:Name="HotkeyWarn" Style="{StaticResource Hint}" Margin="0,10,0,0"
                         Foreground="{DynamicResource Danger}" Visibility="Collapsed"/>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Style="{StaticResource Caption}" Text="ВИДЕО-ОБОИ"/>
              <TextBlock x:Name="VideoStatus" Style="{StaticResource Hint}" Margin="0,0,0,12"/>
              <TextBlock Text="Глушить видео, когда:" Margin="0,0,0,8"/>
              <StackPanel Margin="12,0,0,0">
                <CheckBox x:Name="PauseFullscreen" Content="запущено полноэкранное приложение" Margin="0,0,0,6"
                          ToolTip="Игра или плеер развернулись на весь экран — показывать обои под ними некому. Учитывается только настоящая полноэкранка: обычное развёрнутое окно не считается."/>
                <CheckBox x:Name="PauseCovers" Content="окно закрыло монитор целиком (игры в безрамочном окне)" Margin="0,0,0,6"
                          ToolTip="Игры в безрамочном окне Windows полноэкранными не считает, но монитор они закрывают полностью. Останавливается только закрытый монитор, остальные продолжают играть."/>
                <CheckBox x:Name="PauseBattery" Content="ноутбук работает от батареи" Margin="0,0,0,6"
                          ToolTip="Видео-обои не дают уснуть дискретной видеокарте и заметно едят заряд."/>
                <CheckBox x:Name="PauseLock" Content="экран заблокирован" Margin="0,0,0,6"
                          ToolTip="Локскрин, заставка или переключение пользователя — смотреть обои всё равно некому."/>
                <CheckBox x:Name="PauseRemote" Content="подключение по удалённому рабочему столу"
                          ToolTip="По RDP видео гонит трафик впустую и обычно всё равно не отображается."/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Style="{StaticResource Caption}" Text="РАСПИСАНИЕ"/>
              <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                         Text="В указанное время плейлист меняется на всех мониторах. Расписание кольцевое: до первого правила суток действует последнее."/>
              <ListBox x:Name="SchedList" MaxHeight="110" Margin="0,0,0,8"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
              <StackPanel Orientation="Horizontal">
                <TextBox x:Name="SchedTime" Width="70" ToolTip="Время в формате ЧЧ:ММ"/>
                <ComboBox x:Name="SchedPlaylist" Width="200" Margin="8,0,0,0"/>
                <Button x:Name="SchedAdd" Content="Добавить" Margin="8,0,0,0"
                        ToolTip="Добавить правило: с этого времени на всех мониторах включается выбранный плейлист"/>
                <Button x:Name="SchedDel" Content="Убрать" Margin="8,0,0,0"
                        ToolTip="Удалить выделенное правило"/>
              </StackPanel>
            </StackPanel>
          </Border>

          <Border Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
              <TextBlock Style="{StaticResource Caption}" Text="ФАЙЛЫ"/>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="OpenCfg" Content="config.json"/>
                <Button x:Name="OpenLog" Content="Журнал ошибок" Margin="8,0,0,0"/>
                <Button x:Name="OpenDir" Content="Папка настроек" Margin="8,0,0,0"/>
              </StackPanel>
              <TextBlock x:Name="AboutLine" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>

  </TabControl>
</Window>
