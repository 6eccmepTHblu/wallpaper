<Window x:Class="Wallpaper.QuickPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Быстрый выбор"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Menu.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Border Background="{DynamicResource Scrim}" CornerRadius="14" Padding="22">
    <DockPanel>

      <Grid DockPanel.Dock="Top" Margin="4,0,4,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <TextBlock x:Name="PlTitle" FontSize="20" FontWeight="SemiBold"
                     Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
          <TextBlock x:Name="Counter" FontSize="13" Margin="14,0,0,0"
                     Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
          <Border x:Name="FilterChip" Margin="14,0,0,0" Padding="9,3" CornerRadius="5"
                  Background="{DynamicResource AccentSoft}" Visibility="Collapsed"
                  VerticalAlignment="Center">
            <TextBlock x:Name="FilterText" Foreground="{DynamicResource Accent}" FontFamily="Consolas"/>
          </Border>
        </StackPanel>

        <TextBlock Grid.Column="1" Foreground="{DynamicResource Muted}" FontSize="12"
                   VerticalAlignment="Center"
                   Text="← → ↑ ↓ выбрать · Enter поставить · Tab плейлист · Esc закрыть"/>
      </Grid>

      <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" Background="Transparent">
        <WrapPanel x:Name="Tiles"/>
      </ScrollViewer>

    </DockPanel>
  </Border>
</Window>
