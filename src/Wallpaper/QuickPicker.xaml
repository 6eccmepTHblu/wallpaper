<Window x:Class="Wallpaper.QuickPicker"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Быстрый выбор"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        UseLayoutRounding="True">

  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Menu.xaml"/>
      </ResourceDictionary.MergedDictionaries>

      <!-- Кнопка-плашка под тёмный оверлей: штатный шаблон рисует светлую. -->
      <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="b" Background="{DynamicResource Surface2}" CornerRadius="5"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="b" Property="Background" Value="{DynamicResource AccentSoft}"/>
                  <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Border Background="{DynamicResource Scrim}" CornerRadius="14" Padding="22">
    <DockPanel>

      <Grid DockPanel.Dock="Top" Margin="4,0,4,16">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <TextBlock x:Name="PlTitle" FontSize="20" FontWeight="SemiBold"
                     Foreground="{DynamicResource Ink}" VerticalAlignment="Center"/>
          <TextBlock x:Name="Counter" FontSize="13" Margin="14,0,0,0"
                     Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
          <Border x:Name="FilterChip" Margin="14,0,0,0" Padding="9,3" CornerRadius="5"
                  Background="{DynamicResource AccentSoft}" Visibility="Collapsed"
                  VerticalAlignment="Center">
            <TextBlock x:Name="FilterText" Foreground="{DynamicResource Accent}" FontFamily="Consolas"/>
          </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="RefreshChip" Content="⟳ Обновить" Margin="0,0,16,0"
                  Cursor="Hand" Focusable="False"
                  ToolTip="Перечитать папки плейлиста"/>
          <TextBlock Foreground="{DynamicResource Muted}" FontSize="12"
                     Text="← → ↑ ↓ выбрать · Enter поставить · F5 обновить · Tab плейлист · Esc закрыть"/>
        </StackPanel>
      </Grid>

      <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled" Background="Transparent">
        <WrapPanel x:Name="Tiles"/>
      </ScrollViewer>

    </DockPanel>
  </Border>
</Window>
